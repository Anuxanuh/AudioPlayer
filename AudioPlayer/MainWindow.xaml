<Window x:Class="AudioPlayer.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:AudioPlayer.Views"
		Title="声屿 · Audio Player"
		Icon="/AudioPlayer;component/Assets/player.ico"
		Width="1200"
		Height="860"
		MinWidth="1000"
		MinHeight="760"
		WindowStartupLocation="CenterScreen"
		Background="#F3F6F2"
		Foreground="{StaticResource InkBrush}"
		FontFamily="Microsoft YaHei UI"
		FontSize="14"
		AllowDrop="True"
		Drop="Window_Drop"
		DragOver="Window_DragOver"
		Closing="Window_Closing"
		SourceUpdated="Settings_SourceUpdated"
		PreviewKeyDown="Window_PreviewKeyDown">
	<Window.Resources>
		<Style x:Key="SideNavigationItem"
			   TargetType="TabItem">
			<Setter Property="Foreground"
					Value="{StaticResource InkBrush}" />
			<Setter Property="Margin"
					Value="12,5" />
			<Setter Property="Padding"
					Value="18,15" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Border x:Name="NavBackground"
								Background="Transparent"
								CornerRadius="10"
								Padding="{TemplateBinding Padding}"
								TextElement.Foreground="{StaticResource MutedBrush}">
							<ContentPresenter ContentSource="Header"
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="NavBackground"
										Property="Background"
										Value="#E1EBE5" />
							</Trigger>
							<Trigger Property="IsSelected"
									 Value="True">
								<Setter TargetName="NavBackground"
										Property="Background"
										Value="#D5E8DD" />
								<Setter TargetName="NavBackground"
										Property="TextElement.Foreground"
										Value="{StaticResource AccentBrush}" />
								<Setter TargetName="NavBackground"
										Property="TextElement.FontWeight"
										Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused"
									 Value="True">
								<Setter TargetName="NavBackground"
										Property="BorderBrush"
										Value="{StaticResource AccentBrush}" />
								<Setter TargetName="NavBackground"
										Property="BorderThickness"
										Value="1" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid x:Name="BodyHost"
			  ClipToBounds="True">
			<TabControl x:Name="MainTabs"
						TabStripPlacement="Left"
						Background="Transparent"
						BorderThickness="0"
						ItemContainerStyle="{StaticResource SideNavigationItem}">
				<TabControl.Template>
					<ControlTemplate TargetType="TabControl">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="178" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border Background="#EAF0EA"
									BorderBrush="#DFE7E2"
									BorderThickness="0,0,1,0">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<StackPanel Margin="24,34,24,32">
										<StackPanel Orientation="Horizontal">
											<Image Source="/AudioPlayer;component/Assets/player.png"
												   Width="36"
												   Height="36" />
											<TextBlock Text="声屿"
													   FontSize="24"
													   FontWeight="SemiBold"
													   Margin="10,0,0,0"
													   VerticalAlignment="Center" />
										</StackPanel>
										<TextBlock Text="让声音，有处停留"
												   FontSize="11"
												   Foreground="{StaticResource MutedBrush}"
												   Margin="0,14,0,0" />
									</StackPanel>
									<!-- StackPanel includes each item's margins in its vertical layout. -->
									<ScrollViewer Grid.Row="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
										<StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
									</ScrollViewer>
									<StackPanel Grid.Row="3"
												Margin="26,22">
										<TextBlock Text="LOCAL / OFFLINE"
												   FontSize="10"
												   FontWeight="SemiBold"
												   Foreground="{StaticResource AccentBrush}" />
										<TextBlock Text="你的音乐，留在本机"
												   FontSize="11"
												   Foreground="{StaticResource MutedBrush}"
												   Margin="0,8,0,0" />
									</StackPanel>
								</Grid>
							</Border>
							<ContentPresenter x:Name="PART_SelectedContentHost"
											  Grid.Column="1"
											  Margin="28,28,28,20"
											  ContentSource="SelectedContent" />
						</Grid>
					</ControlTemplate>
				</TabControl.Template>
				<TabItem>
					<TabItem.Header>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE8F1;"
									   FontFamily="Segoe Fluent Icons"
									   FontSize="18"
									   Margin="0,0,12,0" />
							<TextBlock Text="我的音乐" />
						</StackPanel>
					</TabItem.Header>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Margin="0,0,0,24">
							<StackPanel>
								<TextBlock Text="我的音乐"
										   FontSize="28"
										   FontWeight="SemiBold" />
								<TextBlock Text="收藏喜欢的声音，从这里开始聆听"
										   Style="{StaticResource SecondaryText}"
										   Margin="0,8,0,0" />
							</StackPanel>
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Right"
										VerticalAlignment="Center">
								<Button Content="＋ 添加音频"
										Style="{StaticResource PrimaryButton}"
										Click="AddFiles_Click" />
								<Button Content="打开文件夹"
										Padding="14,9"
										Click="AddFolder_Click" />
							</StackPanel>
						</Grid>
						<Border x:Name="PlaylistCard"
								Grid.Row="1"
								Style="{StaticResource Card}"
								Padding="22">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid Margin="0,0,0,18">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel Orientation="Horizontal">
										<ComboBox ItemsSource="{Binding State.Playlists}"
												  DisplayMemberPath="Name"
												  SelectedItem="{Binding SelectedPlaylist}"
												  SelectionChanged="Playlist_SelectionChanged"
												  Width="200"
												  MinHeight="36"
												  AutomationProperties.Name="当前播放列表" />
										<Button Content="&#xE70F;"
												FontFamily="Segoe Fluent Icons"
												Margin="8,0,0,0"
												Padding="10,6"
												Click="RenamePlaylist_Click"
												ToolTip="重命名播放列表"
												AutomationProperties.Name="重命名播放列表" />
									</StackPanel>
									<StackPanel Grid.Column="1"
												Orientation="Horizontal">
										<Button Content="新建列表"
												Padding="12,7"
												Margin="0,0,8,0"
												Click="NewPlaylist_Click" />
										<Button Content="删除列表"
												Padding="12,7"
												Click="DeletePlaylist_Click" />
									</StackPanel>
								</Grid>
								<Border Grid.Row="1"
										Background="#F1F5F2"
										CornerRadius="6"
										Padding="15,10"
										Margin="0,0,0,8">
									<DockPanel>
										<TextBlock DockPanel.Dock="Right"
												   Text="{Binding TrackCount}"
												   FontSize="12"
												   Foreground="{StaticResource MutedBrush}" />
										<TextBlock Text="音频 / 文件位置"
												   FontSize="12"
												   Foreground="{StaticResource MutedBrush}" />
									</DockPanel>
								</Border>
								<Grid Grid.Row="2">
									<ListBox x:Name="TrackList"
											 ItemsSource="{Binding SelectedPlaylist.Tracks}"
											 SelectedItem="{Binding SelectedTrack}"
											 SelectionChanged="Track_SelectionChanged"
											 MouseDoubleClick="Track_DoubleClick"
											 KeyDown="Track_KeyDown"
											 BorderThickness="0"
											 Background="Transparent"
											 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
											 HorizontalContentAlignment="Stretch"
											 VirtualizingPanel.IsVirtualizing="True"
											 VirtualizingPanel.VirtualizationMode="Recycling"
											 AutomationProperties.Name="音频列表">
										<ListBox.ItemTemplate>
											<DataTemplate>
												<Grid Margin="12,12">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="40" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="&#xE8D6;"
															   FontFamily="Segoe Fluent Icons"
															   Foreground="{StaticResource AccentBrush}"
															   VerticalAlignment="Center"
															   FontSize="22" />
													<StackPanel Grid.Column="1">
														<TextBlock Text="{Binding Title}"
																   FontWeight="SemiBold"
																   TextTrimming="CharacterEllipsis" />
														<TextBlock FontSize="11"
																   Foreground="{StaticResource MutedBrush}"
																   TextTrimming="CharacterEllipsis"
																   Margin="0,6,0,0"
																   ToolTip="{Binding FilePath}"><Run Text="{Binding Format, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Folder, Mode=OneWay}" /></TextBlock>
													</StackPanel>
												</Grid>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
									<StackPanel VerticalAlignment="Center"
												HorizontalAlignment="Center"
												IsHitTestVisible="False">
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility"
														Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding SelectedPlaylist.Tracks.Count}"
																 Value="0">
														<Setter Property="Visibility"
																Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>
										<TextBlock Text="从一首喜欢的歌开始"
												   FontSize="16"
												   HorizontalAlignment="Center"
												   Margin="0,0,0,10" />
										<TextBlock Text="添加文件、打开文件夹，&#x0a;或直接拖入音频"
												   Style="{StaticResource SecondaryText}"
												   TextAlignment="Center"
												   HorizontalAlignment="Center" />
									</StackPanel>
								</Grid>
								<DockPanel Grid.Row="3"
										   Margin="0,16,0,0">
									<Button DockPanel.Dock="Right"
											Content="↓"
											Padding="12,5"
											Click="MoveDown_Click"
											AutomationProperties.Name="下移音频" />
									<Button DockPanel.Dock="Right"
											Content="↑"
											Padding="12,5"
											Margin="0,0,8,0"
											Click="MoveUp_Click"
											AutomationProperties.Name="上移音频" />
									<Button DockPanel.Dock="Right"
											Content="移除选中项"
											Margin="0,0,12,0"
											Padding="12,5"
											Click="RemoveTrack_Click"
											ToolTip="只从列表移除，不删除文件" />
									<TextBlock Text="双击播放 · 点击下方封面展开歌词"
											   FontSize="11"
											   Foreground="{StaticResource MutedBrush}"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Grid>
						</Border>
					</Grid>
				</TabItem>
				<TabItem>
					<TabItem.Header>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE8D6;"
									   FontFamily="Segoe Fluent Icons"
									   FontSize="18"
									   Margin="0,0,12,0" />
							<TextBlock Text="本地识别" />
						</StackPanel>
					</TabItem.Header>
					<Border Style="{StaticResource Card}">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<StackPanel Margin="0,0,0,12">
								<TextBlock Text="批量离线识别"
										   FontSize="24"
										   FontWeight="SemiBold" />
								<TextBlock Text="多线程共享模型，支持暂停继续 · 同文件夹同名 LRC · 音频不会上传"
										   Style="{StaticResource SecondaryText}"
										   Margin="0,5,0,0" />
							</StackPanel>
							<StackPanel Grid.Row="1"
										Margin="0,0,0,10">
								<WrapPanel Margin="0,0,0,8">
									<Button Content="批量添加音频…"
											Style="{StaticResource ActionButton}"
											Click="ChooseRecognition_Click"
											IsEnabled="{Binding CanRecognize}" />
									<Button Content="使用列表选中项"
											Style="{StaticResource ActionButton}"
											Click="UseSelectedRecognition_Click"
											IsEnabled="{Binding CanRecognize}" />
									<Button Content="加入整个播放列表"
											Style="{StaticResource ActionButton}"
											Click="UsePlaylistRecognition_Click"
											IsEnabled="{Binding CanRecognize}" />
								</WrapPanel>
								<TextBlock Text="{Binding RecognitionTarget}"
										   FontSize="12"
										   Foreground="{StaticResource MutedBrush}"
										   TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<ListBox x:Name="RecognitionList"
									 Grid.Row="2"
									 ItemsSource="{Binding RecognitionQueue}"
									 SelectionMode="Extended"
									 Background="#F0F5F1"
									 BorderThickness="0"
									 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
									 HorizontalContentAlignment="Stretch"
									 AutomationProperties.Name="批量识别任务">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid Margin="4,6">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="2*" />
											</Grid.ColumnDefinitions>
											<StackPanel Margin="0,0,16,0">
												<TextBlock Text="{Binding Name}"
														   FontWeight="SemiBold"
														   TextTrimming="CharacterEllipsis"
														   ToolTip="{Binding AudioPath}" />
												<TextBlock Text="{Binding Folder}"
														   FontSize="11"
														   TextTrimming="CharacterEllipsis"
														   Foreground="{StaticResource MutedBrush}" />
											</StackPanel>
											<StackPanel Grid.Column="1">
												<TextBlock Text="{Binding Status}"
														   TextTrimming="CharacterEllipsis"
														   ToolTip="{Binding Status}"
														   FontSize="12" />
												<ProgressBar Value="{Binding Percent}"
															 Maximum="100"
															 Height="4"
															 Margin="0,7,0,0" />
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<WrapPanel Grid.Row="3"
									   Margin="0,10,0,10">
								<Button Content="移除选中项"
										Padding="10,5"
										Margin="0,0,8,0"
										Click="RemoveRecognition_Click"
										IsEnabled="{Binding CanRecognize}" />
								<Button Content="清空队列"
										Padding="10,5"
										Margin="0,0,18,0"
										Click="ClearRecognition_Click"
										IsEnabled="{Binding CanRecognize}" />
								<CheckBox Content="覆盖已有 LRC（默认跳过）"
										  IsChecked="{Binding OverwriteLyrics}"
										  IsEnabled="{Binding CanRecognize}"
										  VerticalAlignment="Center" />
								<TextBlock Text="并发任务"
										   Margin="20,0,8,0"
										   VerticalAlignment="Center" />
								<ComboBox ItemsSource="{Binding ParallelismOptions}"
										  SelectedItem="{Binding Settings.RecognitionParallelism, NotifyOnSourceUpdated=True}"
										  IsEnabled="{Binding CanRecognize}"
										  Width="60"
										  AutomationProperties.Name="识别并发任务数"
										  ToolTip="1–4 个文件同时识别；大模型可降低并发数以节省内存和显存" />
							</WrapPanel>
							<WrapPanel Grid.Row="4"
									   Margin="0,0,0,10">
								<Button x:Name="StartBatchButton"
										Content="开始批量识别"
										Style="{StaticResource PrimaryButton}"
										Click="Transcribe_Click"
										IsEnabled="{Binding CanRecognize}" />
								<Button Content="{Binding PauseRecognitionLabel}"
										Style="{StaticResource ActionButton}"
										Click="PauseRecognition_Click"
										IsEnabled="{Binding BatchRunning}" />
								<Button Content="取消识别"
										Style="{StaticResource ActionButton}"
										Click="CancelRecognition_Click"
										IsEnabled="{Binding RecognitionBusy}" />
								<Button Content="检查选中模型"
										Style="{StaticResource ActionButton}"
										Click="CheckRecognition_Click"
										IsEnabled="{Binding CanRecognize}" />
							</WrapPanel>
							<StackPanel Grid.Row="5">
								<ProgressBar Minimum="0"
											 Maximum="100"
											 Value="{Binding RecognitionPercent}"
											 Height="5"
											 Margin="0,0,0,8" />
								<TextBlock Text="{Binding RecognitionStatus}"
										   TextTrimming="CharacterEllipsis"
										   ToolTip="{Binding RecognitionStatus}"
										   FontSize="12" />
							</StackPanel>
						</Grid>
					</Border>
				</TabItem>
				<TabItem>
					<TabItem.Header>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE713;"
									   FontFamily="Segoe Fluent Icons"
									   FontSize="18"
									   Margin="0,0,12,0" />
							<TextBlock Text="设置" />
						</StackPanel>
					</TabItem.Header>
					<ScrollViewer x:Name="SettingsScroll"
								  VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<Border Style="{StaticResource Card}"
									Margin="0,0,0,14">
								<StackPanel>
									<TextBlock Text="桌面歌词"
											   Style="{StaticResource SectionTitle}" />
									<WrapPanel Margin="0,0,0,18">
										<CheckBox Content="显示桌面歌词"
												  IsChecked="{Binding Settings.DesktopLyrics, NotifyOnSourceUpdated=True}"
												  Margin="0,0,28,0" />
										<CheckBox Content="锁定位置并穿透鼠标"
												  IsChecked="{Binding Settings.LockLyrics, NotifyOnSourceUpdated=True}" />
									</WrapPanel>
									<CheckBox Content="竖排桌面歌词（文字从上到下，长句从右向左换列）"
											  IsChecked="{Binding Settings.VerticalLyrics, NotifyOnSourceUpdated=True}"
											  Margin="0,0,0,18" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="24" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="字体"
													   Style="{StaticResource SecondaryText}"
													   Margin="0,0,0,7" />
											<ComboBox x:Name="FontPicker"
													  IsEditable="True"
													  Text="{Binding Settings.FontFamily, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
											<TextBlock Text="{Binding Settings.FontSize, StringFormat=字号：{0:F0} px}"
													   Style="{StaticResource SecondaryText}"
													   Margin="0,16,0,5" />
											<Slider Minimum="16"
													Maximum="80"
													TickFrequency="1"
													IsSnapToTickEnabled="True"
													Value="{Binding Settings.FontSize, NotifyOnSourceUpdated=True}"
													AutomationProperties.Name="歌词字号" />
											<TextBlock Text="{Binding Settings.LyricOffsetSeconds, StringFormat=歌词时间偏移：{0:F1} 秒（正数提前）}"
													   Style="{StaticResource SecondaryText}"
													   Margin="0,16,0,5" />
											<Slider Minimum="-10"
													Maximum="10"
													TickFrequency="0.1"
													IsSnapToTickEnabled="True"
													Value="{Binding Settings.LyricOffsetSeconds, NotifyOnSourceUpdated=True}"
													AutomationProperties.Name="歌词时间偏移" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Text="文字颜色（#RRGGBB 或 #AARRGGBB）"
													   Style="{StaticResource SecondaryText}"
													   Margin="0,0,0,7" />
											<DockPanel>
												<Button DockPanel.Dock="Right"
														Content="选色…"
														Click="ChooseColor_Click"
														Margin="8,0,0,0" />
												<TextBox Text="{Binding Settings.LyricColor, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" />
											</DockPanel>
											<TextBlock Text="{Binding Settings.LyricOpacity, StringFormat=不透明度：{0:P0}}"
													   Style="{StaticResource SecondaryText}"
													   Margin="0,16,0,5" />
											<Slider Minimum="0.3"
													Maximum="1"
													Value="{Binding Settings.LyricOpacity, NotifyOnSourceUpdated=True}"
													AutomationProperties.Name="歌词不透明度" />
											<Button Content="恢复歌词位置"
													HorizontalAlignment="Left"
													Click="ResetLyricsPosition_Click"
													Padding="12,7"
													Margin="0,16,0,0" />
										</StackPanel>
									</Grid>
									<TextBlock Text="解锁后可拖动歌词；锁定后可从托盘菜单解锁。"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,16,0,0" />
								</StackPanel>
							</Border>
							<Border Style="{StaticResource Card}"
									Margin="0,0,0,14">
								<StackPanel>
									<TextBlock Text="关闭与托盘"
											   Style="{StaticResource SectionTitle}" />
									<CheckBox Content="点击窗口关闭按钮时，隐藏到系统托盘并继续播放"
											  IsChecked="{Binding Settings.CloseToTray, NotifyOnSourceUpdated=True}" />
									<TextBlock Text="双击托盘图标恢复窗口；右键菜单可播放 / 暂停、切歌或退出。关闭此选项后，窗口关闭按钮将直接退出程序。"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,10,0,0" />
								</StackPanel>
							</Border>
							<Border Style="{StaticResource Card}" Margin="0,0,0,14">
								<StackPanel>
									<TextBlock Text="插件" Style="{StaticResource SectionTitle}" />
									<TextBlock x:Name="PluginSummary" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
									<ItemsControl x:Name="PluginSettingsList">
										<ItemsControl.ItemTemplate><DataTemplate>
											<Border BorderBrush="#DFE7E2" BorderThickness="0,0,0,1" Padding="0,10">
												<StackPanel>
													<CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
													<TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="26,6,0,0" />
													<TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="26,6,0,0" />
												</StackPanel>
											</Border>
										</DataTemplate></ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
							<Border Style="{StaticResource Card}">
								<StackPanel>
									<TextBlock Text="离线识别引擎"
											   Style="{StaticResource SectionTitle}" />
									<TextBlock Text="Python 可执行文件"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,0,0,7" />
									<DockPanel Margin="0,0,0,14">
										<Button DockPanel.Dock="Right"
												Content="浏览…"
												Click="BrowsePython_Click"
												Margin="8,0,0,0" />
										<TextBox Text="{Binding Settings.PythonPath, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
									</DockPanel>
									<TextBlock Text="模型仓库文件夹"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,0,0,7" />
									<DockPanel Margin="0,0,0,14">
										<Button DockPanel.Dock="Right"
												Content="浏览…"
												Click="BrowseModel_Click"
												Margin="8,0,0,0" />
										<TextBox x:Name="ModelsDirectoryInput"
												 Text="{Binding Settings.ModelsDirectory, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" />
									</DockPanel>
									<TextBlock Text="识别模型"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,0,0,7" />
									<DockPanel Margin="0,0,0,7">
										<Button DockPanel.Dock="Right"
												Content="刷新模型"
												Click="RefreshModels_Click"
												Margin="8,0,0,0" />
										<ComboBox x:Name="ModelPicker"
												  ItemsSource="{Binding Models}"
												  DisplayMemberPath="DisplayName"
												  SelectedValuePath="DirectoryPath"
												  SelectedValue="{Binding Settings.ModelPath, Mode=OneWay}"
												  SelectionChanged="Model_SelectionChanged"
												  AutomationProperties.Name="识别模型" />
									</DockPanel>
									<TextBlock Text="{Binding ModelSummary}"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,0,0,14" />
									<WrapPanel>
										<TextBlock Text="语言代码"
												   VerticalAlignment="Center"
												   Margin="0,0,10,0" />
										<ComboBox IsEditable="True"
												  Width="110"
												  Text="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
												  Margin="0,0,22,0">
											<ComboBoxItem Content="auto" />
											<ComboBoxItem Content="zh" />
											<ComboBoxItem Content="en" />
											<ComboBoxItem Content="ja" />
										</ComboBox>
										<CheckBox Content="使用 NVIDIA CUDA"
												  IsChecked="{Binding Settings.UseCuda, NotifyOnSourceUpdated=True}"
												  VerticalAlignment="Center"
												  Margin="0,0,22,0" />
										<CheckBox Content="语音静音过滤（歌曲不建议）"
												  IsChecked="{Binding Settings.SpeechVad, NotifyOnSourceUpdated=True}"
												  VerticalAlignment="Center" />
									</WrapPanel>
									<TextBlock Text="默认使用 CPU / INT8。CUDA 需兼容的显卡与 CUDA 12、cuDNN 9。模型和依赖准备好后，可断网识别；播放器不会自动下载模型。"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,16,0,0" />
									<CheckBox x:Name="SimplifiedChineseCheckBox"
											  Content="识别结果自动转为简体中文"
											  IsChecked="{Binding Settings.RecognizeToSimplified, NotifyOnSourceUpdated=True}"
											  Margin="0,16,0,0" />
									<TextBlock Text="使用本地繁简字典，适用于实时字幕和新生成的 LRC。关闭后保留识别原文；修改从下一次识别任务生效，已有歌词不变。"
											   Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
									<CheckBox Content="边听边识别：播放没有 LRC 的音频时自动生成字幕"
											  IsChecked="{Binding Settings.AutoRecognizePlaying, NotifyOnSourceUpdated=True}"
											  Margin="0,16,0,0" />
									<TextBlock Text="已识别片段会按音频时间同步显示，完成后保存同名 LRC。切歌会停止上一首的自动识别；首次出字取决于模型加载与识别速度。"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,8,0,0" />
									<WrapPanel Margin="0,16,0,0">
										<Button Content="检测本机环境…"
												Style="{StaticResource PrimaryButton}"
												Click="InspectEnvironment_Click"
												IsEnabled="{Binding CanInspectEnvironment}" />
										<Button Content="检查选中模型"
												Style="{StaticResource ActionButton}"
												Click="CheckRecognition_Click"
												IsEnabled="{Binding CanRecognize}" />
										<Button Content="在线模型与下载…"
												Style="{StaticResource ActionButton}"
												Click="OnlineModels_Click"
												IsEnabled="{Binding CanRecognize}" />
									</WrapPanel>
									<TextBlock Text="检测 Python、显卡驱动、CUDA、cuBLAS 与 cuDNN；结果窗口提供官方下载链接。"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,10,0,0" />
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</TabItem>
			</TabControl>
			<Border x:Name="LyricsDrawer"
					Visibility="Collapsed"
					Background="#E7EFE8"
					KeyboardNavigation.TabNavigation="Cycle">
				<Border.RenderTransform>
					<TranslateTransform x:Name="DrawerTransform" />
				</Border.RenderTransform>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<DockPanel Margin="28,20,28,6">
						<Button x:Name="CloseDrawerButton"
								DockPanel.Dock="Right"
								Content="&#xE70D;"
								FontFamily="Segoe Fluent Icons"
								FontSize="18"
								Padding="14,10"
								Click="CloseDrawer_Click"
								ToolTip="收起歌词（Esc）"
								AutomationProperties.Name="收起封面与歌词" />
						<TextBlock Text="正在聆听"
								   FontSize="15"
								   FontWeight="SemiBold"
								   Foreground="{StaticResource AccentBrush}"
								   VerticalAlignment="Center" />
					</DockPanel>
					<Border x:Name="ListeningCard"
							Grid.Row="1"
							Background="Transparent"
							Padding="48,6,48,30">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"
												  MaxWidth="430" />
								<ColumnDefinition Width="60" />
								<ColumnDefinition Width="1.2*" />
							</Grid.ColumnDefinitions>
							<Grid Margin="0,10,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Text="此刻的声音"
										   Foreground="{StaticResource AccentBrush}"
										   FontSize="12"
										   FontWeight="SemiBold"
										   Margin="0,0,0,16" />
								<Viewbox Grid.Row="1"
										 Stretch="Uniform"
										 MaxWidth="360"
										 MaxHeight="360"
										 HorizontalAlignment="Stretch">
									<Grid Width="264"
										  Height="264">
										<Grid.Clip>
											<RectangleGeometry Rect="0,0,264,264"
															   RadiusX="20"
															   RadiusY="20" />
										</Grid.Clip>
										<Border Background="#D4E5DD" />
										<Image Source="/AudioPlayer;component/Assets/player.png"
											   Width="172"
											   Height="172">
											<Image.Style>
												<Style TargetType="Image">
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasCover}"
																	 Value="True">
															<Setter Property="Visibility"
																	Value="Collapsed" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Image.Style>
										</Image>
										<Image Source="{Binding Cover}"
											   Stretch="UniformToFill"
											   AutomationProperties.Name="当前音频封面" />
									</Grid>
								</Viewbox>
								<TextBlock Grid.Row="2"
										   Text="{Binding CurrentTitle}"
										   FontSize="25"
										   FontWeight="SemiBold"
										   TextWrapping="Wrap"
										   TextTrimming="CharacterEllipsis"
										   MaxHeight="64"
										   Margin="0,16,0,0"
										   ToolTip="{Binding CurrentTitle}" />
								<TextBlock Grid.Row="3"
										   Text="{Binding CurrentInfo}"
										   Style="{StaticResource SecondaryText}"
										   TextTrimming="CharacterEllipsis"
										   MaxHeight="44"
										   Margin="0,6,0,0" />
							</Grid>
							<Grid Grid.Column="2">
								<views:SynchronizedLyricsView x:Name="FullLyrics"
															  Lines="{Binding LyricLines}"
															  CurrentIndex="{Binding CurrentLyricIndex}">
									<views:SynchronizedLyricsView.Style>
										<Style TargetType="views:SynchronizedLyricsView">
											<Setter Property="Visibility"
													Value="Visible" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasLyrics}"
															 Value="False">
													<Setter Property="Visibility"
															Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</views:SynchronizedLyricsView.Style>
								</views:SynchronizedLyricsView>
								<StackPanel VerticalAlignment="Center"
											Margin="12">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasLyrics}"
															 Value="False">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>
									<TextBlock Text="{Binding CurrentLyric}"
											   FontSize="23"
											   FontWeight="SemiBold"
											   TextWrapping="Wrap" />
									<TextBlock Text="{Binding NextLyric}"
											   Style="{StaticResource SecondaryText}"
											   Margin="0,14,0,0"
											   LineHeight="24" />
								</StackPanel>
							</Grid>
							<StackPanel Grid.Row="1"
										Grid.ColumnSpan="3"
										Margin="0,18,0,0">
								<DockPanel>
									<Button DockPanel.Dock="Right"
											Content="载入 LRC"
											Padding="12,7"
											Click="LoadLyrics_Click" />
									<WrapPanel VerticalAlignment="Center">
										<CheckBox Content="桌面歌词"
												  IsChecked="{Binding Settings.DesktopLyrics, NotifyOnSourceUpdated=True}"
												  Margin="0,0,16,0" />
										<CheckBox Content="边听边识别"
												  IsChecked="{Binding Settings.AutoRecognizePlaying, NotifyOnSourceUpdated=True}"
												  ToolTip="没有 LRC 时自动识别并逐段显示字幕，完成后保存同名 LRC" />
									</WrapPanel>
								</DockPanel>
								<TextBlock Text="{Binding LiveRecognitionStatus}"
										   FontSize="11"
										   TextTrimming="CharacterEllipsis"
										   ToolTip="{Binding LiveRecognitionStatus}"
										   Foreground="{StaticResource MutedBrush}"
										   Margin="0,8,0,0">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding LiveRecognitionStatus}"
															 Value="">
													<Setter Property="Visibility"
															Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>
		</Grid>
		<Border Grid.Row="1"
				Background="White"
				BorderBrush="#DFE7E2"
				BorderThickness="0,1,0,0"
				Padding="24,14,24,8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<DockPanel VerticalAlignment="Center"
						   Margin="0,0,18,0">
					<Button x:Name="CoverButton"
							Width="60"
							Height="60"
							Margin="0,0,14,0"
							Padding="0"
							BorderThickness="0"
							Background="Transparent"
							Click="Cover_Click"
							ToolTip="展开封面与歌词"
							AutomationProperties.Name="展开封面与歌词">
						<Grid Width="56"
							  Height="56">
							<Grid.Clip>
								<RectangleGeometry Rect="0,0,56,56"
												   RadiusX="8"
												   RadiusY="8" />
							</Grid.Clip>
							<Image Source="/AudioPlayer;component/Assets/player.png" />
							<Image Source="{Binding Cover}"
								   Stretch="UniformToFill" />
							<Border VerticalAlignment="Bottom"
									Height="17"
									Background="#70000000">
								<TextBlock Text="&#xE70E;"
										   FontFamily="Segoe Fluent Icons"
										   Foreground="White"
										   FontSize="10"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center" />
							</Border>
						</Grid>
					</Button>
					<StackPanel VerticalAlignment="Center">
						<TextBlock Text="{Binding CurrentTitle}"
								   FontWeight="SemiBold"
								   FontSize="16"
								   TextTrimming="CharacterEllipsis"
								   ToolTip="{Binding CurrentTitle}" />
						<TextBlock Text="{Binding CurrentInfo}"
								   Foreground="{StaticResource MutedBrush}"
								   FontSize="11"
								   TextTrimming="CharacterEllipsis"
								   Margin="0,5,0,0" />
					</StackPanel>
				</DockPanel>
				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							VerticalAlignment="Center">
					<Button Content="&#xE892;"
							FontFamily="Segoe Fluent Icons"
							FontSize="17"
							Padding="13,10"
							Click="Previous_Click"
							ToolTip="上一首"
							AutomationProperties.Name="上一首" />
					<Button Style="{StaticResource PrimaryButton}"
							Width="56"
							Height="46"
							Padding="16,12"
							Margin="10,0"
							Click="Play_Click"
							ToolTip="{Binding PlayLabel}"
							AutomationProperties.Name="{Binding PlayLabel}">
						<Path Fill="White"
							  Width="20"
							  Height="20"
							  Stretch="Uniform">
							<Path.Style>
								<Style TargetType="Path">
									<Setter Property="Data"
											Value="M 4,2 L 20,12 L 4,22 Z" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsPlaying}"
													 Value="True">
											<Setter Property="Data"
													Value="M 3,2 H 9 V 22 H 3 Z M 14,2 H 20 V 22 H 14 Z" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Path.Style>
						</Path>
					</Button>
					<Button Content="&#xE893;"
							FontFamily="Segoe Fluent Icons"
							FontSize="17"
							Padding="13,10"
							Click="Next_Click"
							ToolTip="下一首"
							AutomationProperties.Name="下一首" />
				</StackPanel>
				<StackPanel Grid.Column="2"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<ComboBox ItemsSource="{Binding Modes}"
								  DisplayMemberPath="Label"
								  SelectedValuePath="Value"
								  SelectedValue="{Binding Settings.Mode, NotifyOnSourceUpdated=True}"
								  Width="132"
								  AutomationProperties.Name="播放模式" />
						<CheckBox Content="列表循环"
								  IsChecked="{Binding Settings.RepeatPlaylist, NotifyOnSourceUpdated=True}"
								  Margin="12,0,0,0"
								  VerticalAlignment="Center" />
					</StackPanel>
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,8,0,0">
						<ComboBox x:Name="PlaybackRatePicker"
								  ItemsSource="{Binding PlaybackRates}"
								  DisplayMemberPath="Label"
								  SelectedValuePath="Value"
								  SelectedValue="{Binding Settings.PlaybackRate, NotifyOnSourceUpdated=True}"
								  Width="80"
								  Margin="0,0,10,0"
								  AutomationProperties.Name="播放倍速" />
						<TextBlock Text="音量"
								   FontSize="11"
								   Foreground="{StaticResource MutedBrush}"
								   VerticalAlignment="Center"
								   Margin="0,0,10,0" />
						<Slider x:Name="VolumeSlider"
								Width="100"
								Minimum="0"
								Maximum="1"
								SmallChange="0.01"
								LargeChange="0.05"
								IsMoveToPointEnabled="True"
								Value="{Binding Settings.Volume, NotifyOnSourceUpdated=True}"
								AutomationProperties.Name="音量" />
					</StackPanel>
				</StackPanel>
				<Grid Grid.Row="1"
					  Grid.ColumnSpan="3"
					  Margin="0,12,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Text="{Binding PositionText}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{StaticResource MutedBrush}"
							   MinWidth="45" />
					<Slider x:Name="SeekSlider"
							Grid.Column="1"
							Minimum="0"
							Maximum="1"
							Margin="8,0"
							IsEnabled="False"
							ValueChanged="Seek_ValueChanged"
							PreviewMouseLeftButtonDown="Seek_MouseDown"
							PreviewMouseLeftButtonUp="Seek_MouseUp"
							LostMouseCapture="Seek_LostCapture"
							IsMoveToPointEnabled="True"
							AutomationProperties.Name="播放进度" />
					<TextBlock Grid.Column="2"
							   Text="{Binding DurationText}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{StaticResource MutedBrush}"
							   MinWidth="45"
							   TextAlignment="Right" />
				</Grid>
			</Grid>
		</Border>
		<Border Grid.Row="2"
				Background="White"
				Padding="26,0,26,8">
			<TextBlock Text="{Binding Status}"
					   FontSize="11"
					   Foreground="{StaticResource MutedBrush}"
					   TextTrimming="CharacterEllipsis"
					   ToolTip="{Binding Status}" />
		</Border>
	</Grid>
</Window>
