<Window x:Class="AudioPlayer.Views.ModelManagerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="在线模型与下载" Icon="/AudioPlayer;component/Assets/player.ico" Width="900" Height="680" MinWidth="760" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="#F3F6F2" FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="faster-whisper 在线模型" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="仅显示支持的多语言模型；从 Hugging Face 对应仓库下载，识别时仍完全离线。" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14">
   <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="更改目录…" Click="Folder_Click" Margin="10,0,0,0"/>
   <TextBlock x:Name="ModelDirectoryText" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <ListView x:Name="OnlineModels" Grid.Row="2" SelectionMode="Single" SelectionChanged="Selection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="在线多语言模型">
   <ListView.ItemTemplate><DataTemplate>
    <Grid Margin="6,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding Id}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Repo}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding Detail}"/>
    </Grid>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <ProgressBar x:Name="DownloadProgress" Height="6" Maximum="100" Margin="0,0,0,10"/>
   <TextBlock x:Name="StatusText" Text="选择模型查看来源或下载。" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,12"/>
   <WrapPanel>
    <Button x:Name="RefreshButton" Content="刷新在线信息" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
    <Button x:Name="DownloadButton" Content="下载选中模型" Style="{StaticResource PrimaryButton}" Click="Download_Click"/>
    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource ActionButton}" Click="Cancel_Click" IsEnabled="False"/>
    <Button Content="模型源页面" Style="{StaticResource ActionButton}" Click="Source_Click"/>
   </WrapPanel>
  </StackPanel>
 </Grid>
</Window>
