<UserControl x:Class="AudioPlayer.Views.SynchronizedLyricsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Name="Root" Focusable="False" Loaded="View_Loaded" Unloaded="View_Unloaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="同步歌词" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
  <Button Content="回到当前歌词" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="Resume_Click" ToolTip="停止翻阅 5 秒后自动回到播放位置">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFollowing, ElementName=Root}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
  </Button>
  <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
   PanningMode="VerticalOnly" PreviewMouseWheel="Lyrics_MouseWheel" PreviewMouseDown="Lyrics_MouseDown" PreviewTouchDown="Lyrics_TouchDown"
   PreviewKeyDown="Lyrics_KeyDown" ScrollChanged="Lyrics_ScrollChanged" AutomationProperties.Name="完整歌词，可滚轮翻阅，闲置五秒自动跟随">
   <ScrollViewer.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="0.07"/><GradientStop Color="Black" Offset="0.93"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></ScrollViewer.OpacityMask>
   <StackPanel x:Name="ScrollContent">
    <Border x:Name="TopSpace" Height="0"/>
    <ItemsControl x:Name="LyricItems" HorizontalContentAlignment="Stretch">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Padding="12,12" CornerRadius="10" Margin="0,2,6,2">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#D4E5DB"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="21" LineHeight="31" ToolTip="{Binding Timestamp}">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#6C8178"/><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="#145A4C"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border x:Name="BottomSpace" Height="0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
